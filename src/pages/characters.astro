---
import {
  type CharacterData,
  CharacterFilter,
} from "@components/CharacterFilter";
import { allCharacters, getCharacterName } from "@data/characters";
import Layout from "@layouts/Layout.astro";
import { getImageUrl, url } from "@utils/url";

const characterData: CharacterData[] = allCharacters.map((character) => ({
  id: character.id,
  name: getCharacterName(character.id, character.name.get()),
  element: character.combatType.name.get(),
  path: character.path.name.get(),
  cardImageUrl: getImageUrl(character.shopItemIcon.path),
  elementIconUrl: getImageUrl(character.combatType.icon.path),
  stars: character.stars,
  href: url(`/characters/${character.id}`),
}));
---

<Layout title="Characters">
  <main class="bg-background py-6 px-4">
    <CharacterFilter characters={characterData} client:load />
  </main>
</Layout>
