---
import { Card } from "@heroui/react";
import Layout from "@layouts/Layout.astro";
import { url } from "@utils/url";
import { StarRail } from "starrail.js";

const client = new StarRail({
	cacheDirectory: "./cache",
	showFetchCacheLog: false,
});

const allCharacters = client.getAllCharacters();

function toWebP(url: string): string {
	return url.replace(/\.png$/, ".webp");
}
---

<Layout title="Characters">
  <main class="min-h-screen bg-background px-6 py-8">
    <h1 class="mb-8 text-3xl font-bold tracking-tight text-foreground">
      Characters
    </h1>
    <div
      class="grid w-full grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-2"
    >
      {
        allCharacters.map((character) => (
          <a href={url(`/characters/${character.id}`)} class="group outline-none">
            <Card className="w-40 border-2 border-border/80 h-60 transition-transform group-hover:scale-[1.03] group-focus-visible:ring-2 group-focus-visible:ring-foreground">
              <img
                src={toWebP(character.shopItemIcon.url)}
                alt={character.name.get()}
                class="absolute inset-0 h-full w-full object-cover"
              />
              <Card.Footer className="font-heading text-xl z-10 mt-auto">
                {character.name.get()}
              </Card.Footer>
            </Card>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
